{
  "uid": "infrapulse-api",
  "title": "InfraPulse API",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_total{job=\"infrapulse-api\"}[$__rate_interval]))",
          "legendFormat": "{{route}}{{status}}{{stage}}{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_total{job=\"infrapulse-api\",status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_requests_total{job=\"infrapulse-api\"}[$__rate_interval]))",
          "legendFormat": "{{route}}{{status}}{{stage}}{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5,sum by(le)(rate(http_server_request_duration_seconds_bucket{job=\"infrapulse-api\"}[$__rate_interval])))",
          "legendFormat": "{{route}}{{status}}{{stage}}{{job}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_server_request_duration_seconds_bucket{job=\"infrapulse-api\"}[$__rate_interval])))",
          "legendFormat": "{{route}}{{status}}{{stage}}{{job}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency p99",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99,sum by(le)(rate(http_server_request_duration_seconds_bucket{job=\"infrapulse-api\"}[$__rate_interval])))",
          "legendFormat": "{{route}}{{status}}{{stage}}{{job}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(route)(rate(http_server_requests_total{job=\"infrapulse-api\"}[$__rate_interval]))",
          "legendFormat": "{{route}}{{status}}{{stage}}{{job}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Exporter available",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"infrapulse-api\"}",
          "legendFormat": "{{route}}{{status}}{{stage}}{{job}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Event loop age",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - infrapulse_event_loop_last_tick_timestamp_seconds{job=\"infrapulse-api\"}",
          "legendFormat": "{{route}}{{status}}{{stage}}{{job}}"
        }
      ]
    }
  ]
}
