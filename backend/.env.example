POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=infrapulse
POSTGRES_USER=infrapulse
# Set a locally generated password before starting the application.
POSTGRES_PASSWORD=
SERVICE_NAME=infrapulse-api
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT=3
DB_STATEMENT_TIMEOUT_MS=3000
# Exact normalized hosts explicitly authorized for internal monitoring (JSON array).
SERVICE_INTERNAL_HOSTS=[]
# Execution also requires matching private networks for authorized internal hosts.
MONITORING_INTERNAL_NETWORKS=[]
MONITORING_ALLOWED_PORTS=[80,443]
# Empty permits any hostname passing the URL and resolved-address policy.
MONITORING_ALLOWED_HOSTS=[]
MONITORING_CONCURRENCY=10
MONITORING_POLL_SECONDS=5
MONITORING_CONNECT_TIMEOUT=3
MONITORING_RESPONSE_MAX_BYTES=1048576
MONITORING_SHUTDOWN_SECONDS=15
MONITORING_HEARTBEAT_PATH=/tmp/infrapulse-worker-heartbeat

# Local authenticated Grafana. Generate a separate password; never commit backend/.env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Internal listeners enabled by Compose; local Python defaults are disabled/loopback.
METRICS_ENABLED=false
METRICS_HOST=127.0.0.1
API_METRICS_PORT=9000
WORKER_METRICS_PORT=9001
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=http://otel-collector:4318/v1/traces
TELEMETRY_SAMPLE_RATIO=0.1
TELEMETRY_TIMEOUT_SECONDS=1
DEPLOYMENT_ENVIRONMENT=development
